# Copy to .env and fill in your keys (never commit .env)

# Mapbox public access token — required for building data, geocoding, and directions
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# Google Directions API key — optional; used to compare Mapbox vs Google routes
GOOGLE_DIRECTIONS_API_KEY=your_google_directions_api_key_here

# PostgreSQL (optional; SQLite is used by default for local dev)
# DB_PASSWORD=postgres
